# Public API base URL, without a trailing slash
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only OMR backend. The phone calls /api/omr/* on the Next.js origin.
OMR_API_URL=http://127.0.0.1:8000

# LIFF ID is a public identifier embedded in the browser bundle at build time.
# Never put LINE channel secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_LIFF_ID=

# Server-only LINE Messaging API credentials (same OA as the webhook).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel ID hosting this LIFF app, NOT the Messaging API channel ID.
LINE_LOGIN_CHANNEL_ID=
LINE_STUDENT_RICH_MENU_ID=richmenu-bc4a96a5651d7f433285e4493e729acc
# Deliberately shared DEMO account only: example@gmail.com / 0123456789.
DEMO_LOGIN_PASSWORD=0123456789
# Durable session store; required for login, webhook logout and protected routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use separate prefixes/databases for preview and production.
AUTH_REDIS_PREFIX=woodcertify:demo
