# Public API base URL, without a trailing slash
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only OMR backend. The phone calls /api/omr/* on the Next.js origin.
OMR_API_URL=http://127.0.0.1:8000

# Current source reads LIFF_ID; client exposure still needs a code fix.
# LIFF IDs are public identifiers. Never put channel secrets in NEXT_PUBLIC_*.
LIFF_ID=
